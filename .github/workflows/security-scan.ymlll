name: Security Leak Scan

on:
  push:
  pull_request:

jobs:
  scan:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v5

      - name: Smart Secret Scan (strict real leaks only)
        run: |
          echo "🔍 Running strict secret scan..."

          EXCLUDES="--exclude-dir=.git --exclude-dir=node_modules"

          # Only real GitHub tokens
          if grep -r -E "(REMOVED[A-Za-z0-9]{36,}|REMOVED[A-Za-z0-9_]{50,})" . $EXCLUDES; then
            echo "❌ Real GitHub token detected!"
            exit 1
          fi

          echo "✅ Clean — no real secrets detected."

      - name: Run Gitleaks
        uses: gitleaks/gitleaks-action@v2
        with:
          args: detect --no-git
