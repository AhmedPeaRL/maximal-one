{
  "id": 12957369,
  "name": "Evolution Gate",
  "target": "branch",
  "source_type": "Repository",
  "source": "AhmedPeaRL/maximal-one",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": ["refs/heads/main"],
      "include": ["~DEFAULT_BRANCH"]
    }
  },
  "rules": [
    { "type": "pull_request", "parameters": { "required_approving_review_count": 0, "dismiss_stale_reviews_on_push": false, "allowed_merge_methods": ["merge", "squash", "rebase"] } },
    { "type": "required_status_checks", "parameters": { "strict_required_status_checks_policy": true, "required_status_checks": [{ "context": "Evolution Gate" }] } },
    { "type": "required_linear_history" },
    { "type": "code_scanning", "parameters": { "code_scanning_tools": [{ "tool": "CodeQL", "security_alerts_threshold": "all", "alerts_threshold": "errors" }] } },
    { "type": "copilot_code_review", "parameters": { "review_on_push": true, "review_draft_pull_requests": true } }
  ]
}
