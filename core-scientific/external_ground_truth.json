{
  "external_benchmarks": [
    {
      "name": "White noise",
      "validation_rule": {
        "spectral_peak_range": [0.0, 0.3]
      }
    },
    {
      "name": "1/f noise",
      "validation_rule": {
        "spectral_peak_range": [0.8, 1.2]
      }
    },
    {
      "name": "Brownian motion",
      "validation_rule": {
        "spectral_peak_range": [1.8, 2.2]
      }
    },
    {
      "name": "High-order correlated regime",
      "validation_rule": {
        "spectral_peak_range": [2.2, 4.0]
      }
    },
    {
      "name": "Extreme scaling regime",
      "validation_rule": {
        "spectral_peak_range": [4.0, 6.0]
      }
    }
  ],
  "integration_policy": {
    "allow_soft_match": true,
    "soft_match_sigma_multiplier": 2.5,
    "failure_if_none_match": false,
    "flag_new_regime": true
  }
}
