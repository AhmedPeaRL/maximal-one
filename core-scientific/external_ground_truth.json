{
  "external_benchmarks": [
    {
      "name": "1/f Noise (Pink Noise)",
      "validation_rule": {
        "spectral_peak_range": [0.8, 1.2]
      }
    },
    {
      "name": "Brownian Motion",
      "validation_rule": {
        "spectral_peak_range": [1.8, 2.2]
      }
    },
    {
      "name": "White Noise",
      "validation_rule": {
        "spectral_peak_range": [0.0, 0.3]
      }
    },
    {
      "name": "Biological Rhythms (Heart/Brain)",
      "validation_rule": {
        "spectral_peak_range": [0.6, 1.4]
      }
    },
    {
      "name": "Solar Activity (Sunspots)",
      "validation_rule": {
        "spectral_peak_range": [0.9, 1.3]
      }
    }
  ],
  "integration_policy": {
    "failure_if_none_match": true,
    "allow_soft_match": true,
    "soft_match_sigma_multiplier": 2.0
  }
}
