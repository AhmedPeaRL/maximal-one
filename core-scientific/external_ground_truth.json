{
  "external_benchmarks": [
    {
      "name": "White noise",
      "validation_rule": {
        "spectral_peak_range": [0.0, 0.3]
      }
    },
    {
      "name": "Transitional regime",
      "validation_rule": {
        "spectral_peak_range": [0.3, 0.8]
      }
    },
    {
      "name": "Self-consistent regime",
      "validation_rule": {
        "spectral_peak_range": [0.6, 0.9]
      }
    },
    {
      "name": "1/f noise (pink noise)",
      "validation_rule": {
        "spectral_peak_range": [0.8, 1.2]
      }
    },
    {
      "name": "Turbulence (Kolmogorov)",
      "validation_rule": {
        "spectral_peak_range": [1.5, 1.8]
      }
    },
    {
      "name": "Brownian motion",
      "validation_rule": {
        "spectral_peak_range": [1.8, 2.2]
      }
    }
  ],
  "integration_policy": {
    "allow_soft_match": true,
    "soft_match_sigma_multiplier": 2.0,
    "failure_if_none_match": true
  }
}
