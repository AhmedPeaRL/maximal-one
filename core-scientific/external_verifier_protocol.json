{
  "protocol_name": "Independent External Verification Protocol",
  "version": "1.0",
  "principle": "The system must be reproducible by an external entity with zero trust assumptions.",
  "requirements": {
    "input": [
      "canonical_report.json",
      "report.hash",
      "requirements-lock.txt"
    ],
    "environment": "Python 3.11+",
    "steps": [
      "Install dependencies using requirements-lock.txt",
      "Run generate_report.py with fixed seed",
      "Recompute SHA256 of output",
      "Compare with report.hash"
    ]
  },
  "success_condition": {
    "hash_match": true,
    "alpha_within_tolerance": true
  },
  "failure_condition": {
    "hash_mismatch": true,
    "alpha_drift": true
  },
  "philosophical_binding": "Truth is not what the system claims, but what survives independent reconstruction."
}
