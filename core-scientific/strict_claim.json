{
  "title": "Constrained Spectral Persistence Hypothesis",

  "statement": "A spectral persistence signature is hypothesized to occur in selected heterogeneous temporal datasets and to remain distinguishable from appropriately specified stochastic null models under the declared validation protocol. The hypothesis remains unestablished until the declared validation layers agree internally, an appropriate stochastic null is rejected under its stated protocol, independent real-domain replication is demonstrated, and independent clean-checkout computational reproducibility is verified. Post-observation protocol amendments are recorded explicitly and are not represented as preregistered evidence.",
  
  "epistemic_policy": {
    "claim_status_is_machine_gated": true,
    "no_claim_from_single_metric": true,
    "no_claim_from_diagnostic_only_metric": true,
    "no_claim_from_derived_dataset": true,
    "no_claim_from_null_dataset": true,
    "no_claim_from_perturbation_stability_alone": true,
    "no_claim_from_internal_consistency_alone": true,
    "no_claim_from_external_artifact_alone": true,
    "mechanism_not_inferred_from_spectral_separation": true,
    "universality_not_inferred_from_cross_domain_replication": true,
    "hcm_causation_not_inferred_from_spectral_results": true
  },

  "dataset": {
    "primary": "sunspots_full.csv",
    "primary_real_domain_required": true,
    "secondary_required": true,
    "independent_real_domain_required": true,
    "min_independent_secondary_real_domains": 2,
    
    "independent_replication": {
      "required": true,
      "minimum_domains": 2,
      "measurement_validity_is_not_replication": true,
      "same_endpoint_required": true,
      "same_null_family_required": true,
      "same_direction_required": true,
      "domain_level_null_rejection_required": true,
      "derived_domains_excluded": true,
      "null_domains_excluded": true,
      "synthetic_domains_excluded": true
    },

    "eligibility_policy": {
      "scientific_role": "measurement_validity_only",
      "minimum_frequency_bins": 20,
      "minimum_series_length": 256,
      "replication_minimum_series_length": 1024,
      "canonical_nperseg": 1024,
      "short_series_are_not_replication_evidence": true,
      "nonfinite_alpha_excludes_domain_from_replication": true,
      "adaptive_nperseg_does_not_override_frequency_bin_validity": true,
      "ineligible_domains_must_be_reported": true,
      "eligibility_cannot_be_changed_after_observing_domain_result": true
    },
    
    "adversarial_rejection_required": true,
    "cross_domain_required": true,
    "derived_data_excluded_from_replication_count": true,
    "shuffle_controls_excluded_from_replication_count": true,
    "null_controls_excluded_from_replication_count": true
  },
  
  "method": {
    "pipeline": [
      "dataset_preprocessor",
      "windowed_spectral_analysis",
      "bootstrap_estimation",
      "cross_domain_validation",
      "adversarial_filtering",
      "independent_null_testing",
      "clean_checkout_computational_reproduction"
    ],
    
    "primary_estimator": "Welch_PSD",
    "independent_validator": "FFT_periodogram",
    "seed": 42,
    "deterministic": true,

    "canonical_alpha_definition": {
      "name": "canonical_primary_alpha",
      "source": "primary_estimator",
      "estimator": "Welch_PSD",
      "must_be_identical_across_report_layers": true,
      "recomputed_for_consistency_check": true
    },

    "alpha_provenance_required": true,
    "frequency_band_provenance_required": true,
    "estimator_provenance_required": true,
    "normalization_provenance_required": true,
    
    "frequency_resolution": {
      "minimum_frequency_bins": 20,
      "protocol_status": "canonical",
      "amended_from": null,
      "reason": "The canonical estimator uses 1024-point Welch segmentation, providing sufficient frequency resolution inside the declared 0.01-0.05 band while preserving adequate resolution at all declared temporal scales without interpolation or synthetic padding.",
      "scientific_role": "minimum estimator validity requirement, not an evidence-strength criterion"
    }
  },

  "welch_protocol": {
    "nperseg": 1024,
    "window": "hann",
    "detrend": "linear",
    "scaling": "density",
    "noverlap_fraction": 0.5,
    "nfft": "nperseg",
    "return_onesided": true,
    "average": "mean"
  },

  "expected_result": {
    "alpha_range": [
      0.05,
      3.0
    ],
    "max_cross_domain_std": 1.2,
    "max_sigma": 0.85,
    "max_method_delta": 0.30,
    "max_scale_dispersion": 0.40,
    "max_same_estimator_disagreement": 1e-8,
    "max_internal_alpha_disagreement": 0.30,
    "max_bootstrap_center_discrepancy_sigma": 2.5,
    "max_p_value": 0.05,
    "min_independent_secondary_real_domains": 2,
    "primary_real_domain_required": true,
    "scale1_must_equal_canonical": true
  },

  "stochastic_null_protocol": {
    "protocol_version": "v2_exploratory",
    "status": "post_observation_protocol_amendment_not_confirmatory",
    "fresh_validation_required": true,
    "preregistered_confirmation": false,
    "scientific_role": "primary_stochastic_null_gate",
    "claim_promotion_allowed_only_after_fresh_prospective_validation": true,
    "current_dataset_is_not_preregistered_confirmation": true,
    "null_family": "stationary_gaussian_AR_p",
  
    "alternative": {
      "direction": "greater_than_null",
      "endpoint": "canonical_primary_alpha",
      "tail": "upper",
      "interpretation": "The hypothesized persistence signature is operationalized as an elevated canonical spectral exponent relative to the declared short-memory null. A lower-than-null alpha is not treated as support."
    },
   
    "order_selection": {
      "criterion": "AIC",
      "min_order": 1,
      "max_order": 20,
      "trend": "constant",
      "stationarity_required": true
    },
   
    "bootstrap_trials": 1000,
    "minimum_valid_surrogates": 200,
    "burn_in": 1000,
    "p_value_rule": "(exceedances + 1) / (valid_surrogates + 1)",
    "endpoint": "canonical_primary_alpha",
    "refit_order_on_each_surrogate": true,
    "support_requires_rejection": true,
    "permutation_null_is_primary": false
  },

  "scale_validation": {
    "scales": [
      1,
      2,
      4,
      8
    ],
    "base_frequency_band": [
      0.01,
      0.05
    ],
   
    "comparison_basis": "same_original_frequency_band_mapped_into_each_temporally_aggregated_series",
    "synthetic_padding_allowed": false,

    "protocol_amendment": {
      "status": "explicit_amendment_required",
      "reason": "The previous upper bound 0.25 cannot be mapped to scale 8 without exceeding the Nyquist limit. The canonical implementation therefore uses 0.01-0.05 so that the mapped upper frequency remains below Nyquist at every declared scale.",
     
      "amended_from": [
        0.01,
        0.25
      ],
      "amended_to": [
        0.01,
        0.05
      ]
    }
  },

  "bootstrap_validation": {
    "center_discrepancy": {
      "status": "required_validation",
      "max_allowed_sigma_units": 2.5,
      "failure_policy": "claim_support_blocked",
      "does_not_establish_estimator_bias": true,
      "scientific_role": "estimator_consistency_validation"
    }
  },

  "internal_consistency": {
    "required": true,
    "canonical_alpha_must_match_report_alpha": true,
    "canonical_alpha_must_match_spectral_profile": true,
    "canonical_alpha_must_match_separation_observed_alpha": true,
    "canonical_alpha_must_match_statistical_test_observed_alpha": true,
    "canonical_alpha_must_match_consensus_primary_alpha": true,
    "maximum_allowed_alpha_disagreement": 0.30
  },

  "reproducibility": {
    "perturbation_stability": {
      "status": "diagnostic_only",
      "does_not_establish_clean_checkout_reproducibility": true
    },

    "semantic_scope": {
      "clean_checkout_is_computational_reproducibility": true,
      "clean_checkout_is_not_scientific_replication": true,
      "clean_checkout_is_not_laboratory_replication": true,
      "clean_checkout_is_not_independent_implementation_replication": true
    },
  
    "clean_checkout_computational_reproducibility": {
      "required_for_final_reproducibility_claim": true,
      "scope": "same_runner_fresh_public_checkout_exact_commit"
    },
  
    "fingerprint_match": {
      "required_for_final_reproducibility_claim": true
    },
 
    "independent_implementation_replication": {
      "required": false,
      "status": "not_demonstrated"
    },
 
    "independent_laboratory_replication": {
      "required": false,
      "status": "not_demonstrated"
    }
  },

  "falsification": {
    "condition": "If alpha exits [0.05,3.0] OR sigma > 0.85 OR independent cross-domain std > 1.2 OR FFT/Welch disagreement > 0.30 OR internal canonical-alpha disagreement > 0.30 OR bootstrap center discrepancy exceeds 2.5 sigma OR the declared appropriate stochastic null is not rejected at the stated threshold when claim support is evaluated OR fewer than 2 independent secondary real domains are available for replication.",
    "action": "Do not support the scientific claim; mark it under investigation or falsified according to the failed condition."
  },

  "externality": {
    "clean_checkout_computational_reproducibility_required": true,
    "fingerprint_match_required": true,
    "independent_implementation_replication_required": false,
    "independent_laboratory_replication_required": false,
    "external_scientific_replication_required": false,
    "scientific_replication_required_for_claim": true,
    "external_independent_validation_is_recommended": true,
    "external_recognition_is_not_a_machine_gate": true
  },

  "epistemic_status": {
    "current_status": "under_investigation",
    
    "support_requires": [
      "appropriate_stochastic_null_rejection",
      "independent_secondary_real_domain_replication",
      "cross_method_agreement",
      "internal_alpha_consistency",
      "bootstrap_consistency",
      "clean_checkout_computational_reproducibility",
      "fingerprint_match",
      "adversarial_control"
    ],
   
    "diagnostic_only": [
      "permutation_null_rejection",
      "scale_stability",
      "phase_surrogate_separation",
      "prediction_regime_transition",
      "evidence_score"
    ]
  }
}
