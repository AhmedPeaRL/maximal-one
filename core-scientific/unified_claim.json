{
  "title": "Unified Scientific Claim",
  "version": "1.0",

  "core_principle": "Falsifiability-first adaptive validation",

  "alpha_mode": "adaptive",

  "adaptive_alpha": {
    "center_from_data": true,
    "tolerance_sigma_multiplier": 3
  },

  "max_sigma": 0.1,

  "diagnostics": {
    "alpha_soft_margin": 0.5,
    "sigma_soft_margin": 0.05
  },

  "stability_constraints": {
    "max_delta_between_runs": 0.5,
    "consecutive_runs_required": 3
  },

  "null_separation_min": 0.1,

  "verdict_logic": {
    "reject_if": [
      "sigma أعلى من الحد",
      "عدم الاستقرار عبر التشغيلات"
    ],
    "flag_if": [
      "alpha خرج عن النطاق التاريخي"
    ],
    "accept_if": [
      "استقرار عبر التشغيلات",
      "sigma منخفض"
    ]
  }
}
