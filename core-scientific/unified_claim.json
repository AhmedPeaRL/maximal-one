{
  "title": "Unified Scientific Claim",
  "version": "3.0",
  "role": "diagnostic_mirror_of_strict_claim",
  "authoritative_claim_contract": "core-scientific/strict_claim.json",

  "core_principle": "Falsifiability-first validation",

  "epistemic_status": {
    "scientific_claim_supported": false,
    "status": "under_investigation",
    "authoritative_verdict_source": "strict_claim.json"
  },

  "diagnostic_alpha": {
    "canonical_range": [0.05, 3.0],
    "preferred_band": [0.6, 2.2],
    "role": "diagnostic_only"
  },

  "diagnostic_sigma": {
    "canonical_max": 0.85,
    "role": "diagnostic_only"
  },

  "stability_diagnostics": {
    "max_cross_run_delta": 0.5,
    "consecutive_runs": 3,
    "role": "diagnostic_only"
  },

  "verdict_logic": {
    "authoritative": false,
    "acceptance_decision_must_not_be_derived_here": true,
    "strict_claim_controls_verdict": true
  },

  "prohibited_semantics": [
    "confidence_as_probability",
    "adaptive_truth_threshold",
    "historical_range_as_acceptance_boundary",
    "automatic_claim_acceptance"
  ]
}
