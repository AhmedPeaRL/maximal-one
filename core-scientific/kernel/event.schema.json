{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Maximal-One Event",
  "type": "object",
  "required": ["timestamp", "weight"],
  "properties": {
    "timestamp": {
      "type": "number"
    },
    "weight": {
      "type": "number",
      "minimum": 0
    },
    "origin": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
