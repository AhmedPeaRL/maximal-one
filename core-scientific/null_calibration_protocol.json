{
  "protocol_version": "1.1",
  "status": "CALIBRATION_ONLY",
  "scientific_claim_authority": false,
  "promotion_authority": false,

  "purpose": "Prospective calibration of the declared primary stochastic null procedure before any confirmatory use.",

  "confirmation_data_excluded": [
    "real-data/sunspots_full.csv"
  ],

  "candidate_null_families": [
    {
      "name": "stationary_gaussian_ar_p",
      "selection": "AIC",
      "short_memory": true,
      "role": "currently_implemented_calibration_candidate",
      "implemented": true
    }
  ],

  "future_candidate_null_families": [
    {
      "name": "stationary_gaussian_ar_p",
      "selection": "BIC",
      "short_memory": true,
      "role": "future_candidate",
      "implemented": false
    },
    {
      "name": "IAAFT",
      "distribution_preserving": true,
      "role": "future_candidate",
      "implemented": false
    },
    {
      "name": "ARFIMA",
      "long_memory": true,
      "role": "future_candidate",
      "implemented": false
    }
  ],

  "data_generating_processes": [
    {
      "name": "ar1_phi_0_7",
      "phi": [0.7]
    },
    {
      "name": "ar2_phi_0_5_0_2",
      "phi": [0.5, 0.2]
    }
  ],

  "sample_length": 3328,

  "outer_replicates": 50,

  "inner_surrogates": 200,

  "minimum_valid_surrogates": 200,

  "seed": 90210,

  "burn_in": 2000,

  "decision_threshold": 0.05,

  "endpoint": "canonical_primary_alpha",

  "direction": "greater_than_null",

  "tail": "upper",

  "metrics": [
    "empirical_rejection_rate",
    "p_value_quantiles",
    "surrogate_boundary_fraction",
    "observed_fit_boundary_fraction",
    "alpha_failure_rate",
    "refit_failure_rate",
    "outer_replicate_failure_rate"
  ],

  "selection_policy": {
    "selection_is_declared_before_confirmation": true,
    "confirmation_data_must_not_select_null_family": true,
    "smallest_observed_p_value_must_not_select_null_family": true,
    "favorable_observation_must_not_select_null_family": true,
    "post_observation_null_selection_is_not_confirmatory": true
  },

  "failure_policy": {
    "insufficient_valid_outer_replicates": "BLOCK_CONFIRMATION_USE",
    "surrogate_failure": "REPORT_AND_REVIEW",
    "boundary_saturation": "REQUIRE_MODEL_CAPACITY_REVIEW",
    "calibration_failure_does_not_falsify_hypothesis": true,
    "calibration_failure_does_not_authorize_favorable_null": true
  },

  "promotion_policy": {
    "calibration_alone_cannot_establish_claim": true,
    "calibration_cannot_count_as_real_domain_replication": true,
    "null_family_cannot_become_confirmatory_only_because_it_favors_observation": true,
    "fresh_prospective_validation_required": true
  },

  "final_epistemic_statement": "This calibration protocol evaluates whether the declared stochastic-null procedure behaves as intended under known stationary short-memory data-generating processes. It does not establish the spectral persistence hypothesis."
}
