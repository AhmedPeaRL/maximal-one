{
  "protocol_version": "1.1",
  "status": "CALIBRATION_ONLY",
  "scientific_claim_authority": false,
  "promotion_authority": false,

  "purpose": "Prospective calibration of candidate stochastic null families before any future confirmation analysis.",

  "confirmation_data_must_not_be_used_for_null_selection": true,
  "primary_confirmation_dataset": "real-data/sunspots_full.csv",
  "primary_confirmation_dataset_must_not_be_used_for_calibration": true,

  "calibration_data_policy": {
    "must_be_distinct_from_confirmation_data": true,
    "must_not_be_derived_from_confirmation_data": true,
    "must_not_use_confirmation_alpha": true,
    "must_not_use_confirmation_p_value": true,
    "must_not_use_confirmation_outcome_for_selection": true,
    "data_generating_processes_must_be_declared_before_execution": true,
    "seed_must_be_declared_before_execution": true
  },

  "calibration_objectives": {
    "type_i_error_control": true,
    "p_value_calibration": true,
    "surrogate_validity": true,
    "order_selection_boundary_behavior": true,
    "finite_failure_rate": true
  },

  "candidate_null_families": [
    {
      "name": "stationary_gaussian_ar_p",
      "selection": "AIC",
      "short_memory": true,
      "role": "currently_implemented_calibration_candidate",
      "implemented": true
    }
  ],

  "future_candidate_null_families":[
    {
      "name": "stationary_gaussian_ar_p",
      "selection": "BIC",
      "short_memory": true,
      "role": "future_candidate",
      "implemented": false
    },
    {
      "name": "IAAFT",
      "distribution_preserving": true,
      "role": "future_candidate",
      "implemented": false
    },
    {
      "name": "ARFIMA",
      "long_memory": true,
      "role": "future_candidate",
      "implemented": false
    }
  ]

  "calibration_data_generating_processes": [
    {
      "name": "AR1_phi_0_7",
      "family": "stationary_gaussian_ar",
      "parameters": {
        "phi": [0.7]
      }
    },
    {
      "name": "AR2_phi_0_5_0_2",
      "family": "stationary_gaussian_ar",
      "parameters": {
        "phi": [0.5, 0.2]
      }
    }
  ],

  "calibration_sample_length": 3328,

  "calibration_replicates": {
    "outer_replicates": 50,
    "inner_surrogates": 200,
    "minimum_valid_surrogates": 200
  },

  "declared_seed": 90210,

  "primary_endpoint": {
    "name": "canonical_primary_alpha",
    "estimator": "Welch_PSD",
    "frequency_band": [0.01, 0.05],
    "nperseg": 1024
  },

  "calibration_metrics": [
    "empirical_rejection_rate_at_0_05",
    "p_value_quantiles",
    "surrogate_boundary_fraction",
    "observed_fit_boundary_fraction",
    "surrogate_alpha_failure_rate",
    "refit_failure_rate"
  ],

  "selection_rules": {
    "must_be_declared_before_confirmation": true,
    "must_not_use_confirmation_alpha": true,
    "must_not_use_confirmation_p_value": true,
    "must_not_select_by_smallest_p_value": true,
    "must_not_select_by_favorable_claim_outcome": true,
    "must_not_select_after_observing_confirmation_result": true,
    "adequacy_metrics_must_be_predeclared": true
  },

  "decision_policy": {
    "calibration_failure_blocks_confirmation_use": true,
    "calibration_failure_does_not_falsify_the_scientific_hypothesis": true,
    "calibration_failure_does_not_authorize_switching_to_a_favorable_null": true,
    "candidate_nulls_must_be_compared_by_predeclared_adequacy_metrics": true,
    "no_candidate_is_promoted_solely_from_a_favorable_confirmation_result": true
  },

  "required_outputs": [
    "protocol_version",
    "calibration_dataset",
    "data_generating_process",
    "seed",
    "outer_replicates",
    "inner_surrogates",
    "null_family",
    "selection_rule",
    "empirical_rejection_rate",
    "p_value_quantiles",
    "boundary_rate",
    "failure_rate",
    "decision"
  ],

  "promotion_rule": "No calibrated null family becomes confirmatory merely because it produces a favorable result on the existing observation.",

  "scientific_role": "calibration_only",

  "claim_support": false,

  "final_statement": "Calibration establishes properties of the null-testing procedure under declared calibration processes. It does not establish the spectral persistence hypothesis and does not count as independent scientific replication."
}
