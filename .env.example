# GitHub token used only for repository-dispatch operations.
# Never place a real token in this file.
GH_TOKEN=<set-via-github-actions-secret>

# Witness signing secret.
# Never commit a real value.
WITNESS_SECRET=<set-via-github-actions-secret>

# Optional external repository identifier.
# Leave unset unless required by the workflow.
GH_REPO=<set-via-github-actions-secret>

# Optional external validation source.
# Leave unset unless required by the workflow.
EXTERNAL_SOURCE_URL=<set-via-github-actions-secret>
