{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HCM Type-I Occurrence Manual Adjudication Overlay V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_commit_sha",
    "inventory_ref",
    "inventory_sha256",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "HCM_TYPE1_OCCURRENCE_MANUAL_ADJUDICATION_OVERLAY_V3"
    },
    "review_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "inventory_ref": {
      "type": "string",
      "minLength": 1
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "second_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "reviewer_kind",
        "reviewer_role",
        "conflict_statement",
        "reviewed_at_utc",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "PENDING",
            "AGREED",
            "DISAGREED"
          ]
        },
        "reviewer": { "type": "string" },
        "reviewer_kind": {
          "enum": ["HUMAN", "AI", "AUTOMATED", "NONE"]
        },
        "reviewer_role": { "type": "string" },
        "conflict_statement": { "type": "string" },
        "reviewed_at_utc": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_id",
        "manual_classification",
        "can_influence_execution",
        "direct_caller_or_workflow_step",
        "indirect_call_path",
        "runner_entry_point_or_command",
        "trigger_conditions_and_branch_restrictions",
        "matrix_and_protocol_consumed",
        "authorization_guard_and_execution_order",
        "guard_fails_closed",
        "negative_test",
        "test_run_job_artifact_commit",
        "historical_diagnostic_proposed_governance_status",
        "reviewer",
        "reviewer_kind",
        "reviewer_role",
        "conflict_statement",
        "reviewed_at_utc",
        "rationale",
        "status",
        "reviewer_disposition",
        "closure_evidence",
        "second_review"
      ],
      "properties": {
        "occurrence_id": { "type": "string", "minLength": 1 },
        "manual_classification": {
          "enum": [
            "EXECUTION_ENTRY_POINT",
            "EXECUTION_CALLER",
            "WORKFLOW_TRIGGER_OR_CONTROL",
            "AUTHORIZATION_GUARD",
            "TEST_ONLY",
            "DOCUMENTATION_ONLY",
            "HISTORICAL_OR_SUPERSEDED",
            "DIAGNOSTIC_ONLY",
            "POLICY_OR_CONFIGURATION",
            "NON_EXECUTABLE_REFERENCE",
            "UNRESOLVED"
          ]
        },
        "can_influence_execution": {
          "enum": ["YES", "NO", "UNRESOLVED"]
        },
        "direct_caller_or_workflow_step": { "type": "string" },
        "indirect_call_path": { "type": "string" },
        "runner_entry_point_or_command": { "type": "string" },
        "trigger_conditions_and_branch_restrictions": { "type": "string" },
        "matrix_and_protocol_consumed": { "type": "string" },
        "authorization_guard_and_execution_order": { "type": "string" },
        "guard_fails_closed": {
          "enum": ["YES", "NO", "UNRESOLVED", "NOT_APPLICABLE"]
        },
        "negative_test": { "type": "string" },
        "test_run_job_artifact_commit": { "type": "string" },
        "historical_diagnostic_proposed_governance_status": { "type": "string" },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewer_kind": { "const": "HUMAN" },
        "reviewer_role": { "type": "string", "minLength": 1 },
        "conflict_statement": { "type": "string", "minLength": 1 },
        "reviewed_at_utc": { "type": "string", "format": "date-time" },
        "rationale": { "type": "string", "minLength": 1 },
        "status": { "enum": ["OPEN", "CLOSED"] },
        "reviewer_disposition": { "enum": ["ADJUDICATED", "PENDING"] },
        "closure_evidence": {
          "type": ["object", "null"]
        },
        "second_review": {
          "$ref": "#/$defs/second_review"
        }
      }
    }
  }
}
